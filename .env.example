# LiciTot environment variables. Copy to .env.local and fill in.
# NEXT_PUBLIC_* values are exposed to the browser; everything else is server-only.
# On Firebase App Hosting, set secrets with `firebase apphosting:secrets:set NAME`
# and reference them in apphosting.yaml.

# ── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Phase 2) ──────────────────────────────────────────────────
# Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_
# Server-only: bypasses RLS. Used by rate limiting, the Stripe webhook, admin tasks and seeding.
SUPABASE_SECRET_KEY=sb_secret_

# Supabase CLI only (pnpm db:link / db:push / db:config / db:types) — not read by the app.
SUPABASE_PROJECT_REF=
# Account → Access Tokens
SUPABASE_ACCESS_TOKEN=sbp_
# Project Settings → Database
SUPABASE_DB_PASSWORD=
# Auth config pushed by `pnpm db:config` (see supabase/config.toml)
SUPABASE_AUTH_SITE_URL=http://localhost:3000
SUPABASE_AUTH_PROD_REDIRECT=https://YOUR-APP.web.app/**
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ── ImageKit (Phase 3) ──────────────────────────────────────────────────
# Developer options → API keys
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/YOUR_ID
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
# Server-only: signs upload tokens in /api/imagekit/auth. Never expose.
IMAGEKIT_PRIVATE_KEY=

# ── Stripe — TEST MODE ONLY (Phase 6) ───────────────────────────────────
# Keys must start with pk_test_ / sk_test_. The app refuses live keys.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally,
# or the webhook endpoint's signing secret in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_

# ── Email (Phase 7, optional) ───────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="LiciTot <noreply@example.com>"
