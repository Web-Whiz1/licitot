{
  "name": "licitot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "dotenv -e .env.local -- playwright test",
    "test:db": "dotenv -e .env.local -- vitest run --config vitest.integration.config.mts",
    "icons": "tsx scripts/gen-icons.ts",
    "icons:ui": "tsx scripts/gen-ui-icons.ts && prettier --write src/components/icons.tsx",
    "sb": "dotenv -e .env.local -- supabase",
    "ntl": "pnpm dlx --package=netlify-cli@27.12.0 netlify",
    "db:link": "dotenv -e .env.local -- node -e \"require('child_process').execSync('supabase link --project-ref ' + process.env.SUPABASE_PROJECT_REF + ' -p ' + JSON.stringify(process.env.SUPABASE_DB_PASSWORD), {stdio:'inherit'})\"",
    "db:push": "dotenv -e .env.local -- supabase db push",
    "db:config": "dotenv -e .env.local -- supabase config push",
    "db:types": "dotenv -e .env.local -- node -e \"require('child_process').execSync('supabase gen types typescript --project-id ' + process.env.SUPABASE_PROJECT_REF + ' --schema public > src/types/database.ts', {stdio:'inherit'})\"",
    "stripe:webhooks": "dotenv -e .env.local -- tsx scripts/stripe-webhooks.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "vc": "pnpm dlx vercel@62.4.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@imagekit/next": "^2.1.6",
    "@stripe/connect-js": "3.4.6",
    "@stripe/react-connect-js": "3.4.4",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lenis": "1.3.26",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "stripe": "22.6.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@iconify-json/ph": "1.2.2",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.11.2"
}
